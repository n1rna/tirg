---
import { Badge } from '@/components/ui/badge'
import {
  getCombinedReadingTime,
  getSubpostCount,
  isSubpost,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import Link from './Link.astro'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const formattedDate = formatDate(entry.data.date)
const readTime = await getCombinedReadingTime(entry.id)
const subpostCount = !isSubpost(entry.id) ? await getSubpostCount(entry.id) : 0
---

<Link
  href={`/${entry.collection}/${entry.id}`}
  class="group relative block rounded-xl border bg-transparent p-5 transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-foreground/30 hover:bg-secondary/40 hover:shadow-[0_1px_0_0_var(--border),0_8px_24px_-12px_rgba(0,0,0,0.12)]"
>
  <div class="flex flex-col gap-4 sm:flex-row">
    {
      entry.data.image && (
        <div class="ring-border/60 relative w-full overflow-hidden rounded-lg ring-1 sm:w-48 sm:shrink-0">
          <Image
            src={entry.data.image}
            alt={entry.data.title}
            width={640}
            height={360}
            class="aspect-[16/9] size-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          />
        </div>
      )
    }

    <div class="flex min-w-0 grow flex-col">
      <div class="mb-1.5 flex items-center gap-2 font-mono text-[11px] text-muted-foreground/80">
        <span>{formattedDate}</span>
        <span class="text-muted-foreground/40">·</span>
        <span>{readTime}</span>
        {
          subpostCount > 0 && (
            <>
              <span class="text-muted-foreground/40">·</span>
              <span class="flex items-center gap-1">
                <Icon name="lucide:file-text" class="size-3" />
                {subpostCount} subpost{subpostCount === 1 ? '' : 's'}
              </span>
            </>
          )
        }
      </div>

      <div class="flex items-start justify-between gap-2">
        <h3 class="text-lg font-medium tracking-tight">
          {entry.data.title}
        </h3>
        <Icon
          name="lucide:arrow-up-right"
          class="text-muted-foreground/70 group-hover:text-foreground mt-1 size-4 shrink-0 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
        />
      </div>

      {
        entry.data.description && (
          <p class="text-muted-foreground mt-1 text-sm leading-relaxed">
            {entry.data.description}
          </p>
        )
      }

      {
        entry.data.tags && entry.data.tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-1.5">
            {entry.data.tags.map((tag) => (
              <Badge
                variant="secondary"
                className="font-mono text-[10px] font-normal tracking-tight"
              >
                #{tag}
              </Badge>
            ))}
          </div>
        )
      }
    </div>
  </div>
</Link>
