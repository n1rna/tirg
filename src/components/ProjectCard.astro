---
import Link from '@/components/Link.astro'
import { Badge } from '@/components/ui/badge'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props

function formatShort(date: Date) {
  return Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
  }).format(date)
}
---

<Link
  href={project.data.link}
  external
  class="group relative block rounded-xl border bg-transparent p-5 transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-foreground/30 hover:bg-secondary/40 hover:shadow-[0_1px_0_0_var(--border),0_8px_24px_-12px_rgba(0,0,0,0.12)]"
>
  <div class="flex items-start gap-4">
    {
      project.data.image && (
        <div class="bg-secondary/40 ring-border/60 relative flex size-14 shrink-0 items-center justify-center overflow-hidden rounded-lg ring-1 sm:size-16">
          <Image
            src={project.data.image}
            alt={project.data.name}
            width={256}
            height={256}
            class="size-full object-contain p-2"
          />
        </div>
      )
    }
    <div class="min-w-0 grow">
      <div class="flex items-start justify-between gap-2">
        <h3
          class="truncate text-base font-medium tracking-tight sm:text-lg"
        >
          {project.data.name}
        </h3>
        <Icon
          name="lucide:arrow-up-right"
          class="text-muted-foreground/70 group-hover:text-foreground mt-1 size-4 shrink-0 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
        />
      </div>
      <p class="text-muted-foreground mt-1 text-sm leading-relaxed">
        {project.data.description}
      </p>

      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2">
        {
          project.data.tags && (
            <div class="flex flex-wrap gap-1.5">
              {project.data.tags.map((tag: string) => (
                <Badge
                  variant="secondary"
                  className="font-mono text-[10px] font-normal tracking-tight"
                >
                  {tag}
                </Badge>
              ))}
            </div>
          )
        }
        {
          project.data.startDate && (
            <span class="text-muted-foreground/70 ml-auto flex items-center gap-x-1 font-mono text-[10px]">
              <Icon name="lucide:calendar" class="size-3" />
              {formatShort(project.data.startDate)}
              {project.data.endDate
                ? ` – ${formatShort(project.data.endDate)}`
                : ' – now'}
            </span>
          )
        }
      </div>
    </div>
  </div>
</Link>
